; Zino Racing Engine — Zino Editor application (Godot 4.7 project)

config_version=5

[application]

config/name="Zino Racing Engine"
config/description="Racing game development environment built on Godot."
config/version="1.1.0"
run/main_scene="res://app/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
run/low_processor_mode=false
config/windows_native_icon=""

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=2
window/energy_saving/keep_screen_on=false

[gui]

theme/default_theme_scale=1.0
common/drop_mouse_on_gui_input_disabled=true

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=40
3d/physics_engine="GodotPhysics3D"

[rendering]

textures/vram_compression/import_etc2_astc=true

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_taa=true
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=5
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=5
lights_and_shadows/positional_shadow/atlas_size=8192
textures/default_filters/anisotropic_filtering_level=4
environment/defaults/default_clear_color=Color(0.07, 0.075, 0.09, 1)
